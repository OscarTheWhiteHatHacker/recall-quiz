# Recall settings — copy to .env (or export directly) to configure without the wizard.
# Anything set in the environment wins over config.env, so this is the file to use for
# systemd EnvironmentFile= or docker -e deployments.
#
# Every one of these can also be entered on the first-run setup page, which writes
# config.env (chmod 600) instead. Secret values must be pasted in yourself — this file is
# committed, config.env is not.

# ---- required ---------------------------------------------------------------
# Writes the questions. ollama.com -> Settings -> Keys (free tier, fastest)
OLLAMA_API_KEY=
# Fallback generator, used automatically when Ollama is missing or failing. build.nvidia.com
NVIDIA_API_KEY=
# ---- optional ---------------------------------------------------------------
# Marks the answers. api.typesafe.ai -> API keys. Leave blank and the generation model does it.
# Anything in the environment overrides config.env, so systemd EnvironmentFile= works too.
TYPESAFE_API_KEY=

# ---- generation endpoints (defaults are fine) -------------------------------
OLLAMA_URL=https://ollama.com/v1/chat/completions
OLLAMA_MODEL=gpt-oss:120b
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
GEN_MODEL=z-ai/glm-5.3-flash
JEV_URL=https://api.typesafe.ai/v1/systemone

# ---- AI access --------------------------------------------------------------
# no = this instance's own keys (above) are used for everyone.
# yes = every visitor pastes their own keys in the browser; the keys above are IGNORED and
#       nothing is stored server-side. For public instances you don't want to pay for.
KEYS_FROM_VISITORS=no

# ---- payments (optional; OFF by default — the app is free) -----------------
# no = free instance: no balance, no checkout, no charges at all.
# yes = charge per quiz (pick a provider below; 'mock' is the built-in test checkout).
PAYMENTS_ENABLED=no
# mock | plisio | cryptomus
PAYMENT_PROVIDER=mock
# Public HTTPS base URL: provider callbacks arrive at <this>/api/webhook/<provider>.
# Leave blank and the app infers it from the request (fine behind one proxy).
PUBLIC_BASE_URL=
# plisio (crypto in, email-only onboarding)
PLISIO_SECRET_KEY=
# Optional comma list of coins to offer, e.g. USDT_TRX,BTC,ETH,TON,LTC
PLISIO_PSYS=
# cryptomus (cards; merchant onboarding requires KYC)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
# Signs the mock provider's test webhooks so the flow can be exercised locally.
MOCK_WEBHOOK_SECRET=

# ---- pricing (minor units: 100 = one currency unit) -------------------------
CURRENCY=USD
CURRENCY_SYMBOL=$
# per 5 questions, charged only after a quiz is generated successfully
PRICE_PER_5_CENTS=1
# top-up step ($1.00)
TOPUP_CENTS=100
# free credit given to a brand new account (0 = paywall immediately)
FREE_CREDIT_CENTS=0
MAX_BALANCE_CENTS=10000

# ---- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=3460
# Owner access to /admin and /api/admin/reconcile. Auto-generated by the wizard.
ADMIN_TOKEN=
# SQLite ledger location
BILLING_DB=./billing.db
# Where the wizard writes settings; also lets you keep several installs apart.
RECALL_CONFIG=./config.env
